---
import Layout from "@/layouts/Layout.astro";
import FacetHero from "@/components/facets/FacetHero.astro";
import FacetGrid from "@/components/facets/FacetGrid.astro";
import FilmSection from "@/components/home/FilmSection.astro";
import ContactCta from "@/components/shared/ContactCta.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
import YouTubeEmbed from "@/components/shared/YouTubeEmbed.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { Button } from "@/components/ui/Button";
import { datosHome } from "@/api/home";
import { FILM_VIDEO_ID } from "@/constants/site";

const film = datosHome.cortometraje;
const { productora, director, actrices, entrevistador } = film.elencoYEquipo;

const CREDITS = [
  { role: "Producción", names: [productora] },
  { role: "Dirección", names: [director] },
  { role: "Elenco", names: actrices },
  { role: "Entrevista", names: [entrevistador] },
];
---

<Layout
  facet="productora"
  title="Productora"
  description={`Mónica Martínez como productora: «${film.titulo}», estrenado en ${film.lugar}.`}
>
  <FacetHero
    facet="productora"
    title="Del papel"
    accent="a la pantalla"
    description="Produzco historias con talento emergente del cine mexicano. Mi primer cortometraje nace de uno de los cuentos de mi libro."
  >
    <Button href="#ver" size="lg">Ver el cortometraje</Button>
    <Button href="/contacto" variant="outline" size="lg">Producir juntas</Button>
  </FacetHero>

  <section id="ver" class="scroll-mt-24 px-4 pb-8 md:px-8">
    <ScrollReveal client:visible blur className="mx-auto max-w-6xl">
      <YouTubeEmbed id={FILM_VIDEO_ID} title={film.titulo} />
    </ScrollReveal>
  </section>

  <FilmSection film={film} eyebrow="Cortometraje · 2026" />

  <section class="bg-surface px-4 py-24 md:px-8 md:py-36">
    <div class="mx-auto flex max-w-6xl flex-col gap-14 md:gap-20">
      <SectionHeading eyebrow="Créditos" title="Hecho en Monterrey, " accent="con talento local" />

      <dl class="grid gap-px overflow-hidden rounded-3xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          CREDITS.map((credit, i) => (
            <div class="bg-bgColor">
              <ScrollReveal client:visible delay={i * 0.1} className="h-full p-7 md:p-8">
                <dt class="text-[0.65rem] tracking-[0.25em] text-primary uppercase">{credit.role}</dt>
                {credit.names.map((name) => (
                  <dd class="mt-3 font-serif text-2xl leading-snug text-ink">{name}</dd>
                ))}
              </ScrollReveal>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <FacetGrid exclude="productora" eyebrow="Explora" title="Otras " accent="facetas" description="" />

  <ContactCta
    eyebrow="Coproducciones"
    title="¿Tienes una historia? "
    accent="Llevémosla a la pantalla"
    description="Cortometrajes, contenido de marca y proyectos audiovisuales con propósito."
  />
</Layout>
