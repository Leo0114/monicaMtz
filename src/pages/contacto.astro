---
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/components/contact/ContactForm";
import ContactInfo from "@/components/contact/ContactInfo.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
---

<Layout
  title="Contacto"
  description="Colaboraciones, prensa y proyectos con Mónica Martínez. Escríbeme y platiquemos."
>
  <section class="relative isolate px-4 pt-32 pb-12 md:px-8 md:pt-44 md:pb-20">
    <div
      aria-hidden="true"
      class="absolute -top-40 left-1/2 -z-10 size-[32rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl md:size-[48rem]"
    >
    </div>
    <div class="mx-auto max-w-6xl">
      <SectionHeading
        as="h1"
        eyebrow="Contacto"
        title="Platiquemos, "
        accent="con calma y con café"
        description="Para colaboraciones, entrevistas, eventos o simplemente para saludar. Leo cada mensaje personalmente."
      />
    </div>
  </section>

  <section class="px-4 pb-8 md:px-8">
    <div class="mx-auto grid max-w-6xl gap-14 md:grid-cols-12 md:gap-16">
      <ScrollReveal client:visible delay={0.1} className="md:col-span-7">
        <div class="rounded-[2rem] border border-line bg-surface p-6 shadow-[0_40px_80px_-50px] shadow-primary/30 md:p-12">
          <ContactForm client:visible />
        </div>
      </ScrollReveal>

      <aside class="md:col-span-5">
        <ContactInfo />
      </aside>
    </div>
  </section>
</Layout>
