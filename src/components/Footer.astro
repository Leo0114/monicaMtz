---
import { Image } from "astro:assets";
import brandLogo from "@/assets/realLogo.jpeg";
import SocialIcon from "@/components/shared/SocialIcon";
import { AGENCY, CONTACT, FACETS, NAV_LINKS, SITE, SOCIAL_LINKS } from "@/constants/site";

const year = new Date().getFullYear();
---

<footer class="relative mt-24 overflow-hidden border-t border-line bg-surface md:mt-32">
  <!-- Firma decorativa -->
  <p
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-6 left-1/2 -translate-x-1/2 font-serif text-[22vw] leading-none whitespace-nowrap text-primary/[0.05] select-none md:-bottom-12"
  >
    Mony
  </p>

  <div class="relative mx-auto grid max-w-6xl gap-12 px-4 py-16 md:grid-cols-12 md:px-8 md:py-20">
    <div class="flex flex-col items-start gap-5 md:col-span-4">
      <Image
        src={brandLogo}
        alt={SITE.name}
        width={160}
        height={160}
        class="size-24 rounded-full border border-line object-cover dark:opacity-90"
      />
      <p class="max-w-xs font-serif text-2xl leading-snug text-ink italic">
        “Primero ser y después tener.”
      </p>
    </div>

    <nav aria-label="Pie de página" class="grid grid-cols-2 gap-8 md:col-span-5">
      <div class="flex flex-col gap-4">
        <p class="text-[0.65rem] tracking-[0.25em] text-muted uppercase">Explora</p>
        <ul class="flex flex-col gap-2">
          {
            NAV_LINKS.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="inline-block py-1 text-ink transition-all duration-500 ease-apple hover:translate-x-1 hover:text-primary"
                >
                  {label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${CONTACT.email}`}
              class="inline-block py-1 text-ink transition-all duration-500 ease-apple hover:translate-x-1 hover:text-primary"
            >
              Escríbeme
            </a>
          </li>
        </ul>
      </div>

      <div class="flex flex-col gap-4">
        <p class="text-[0.65rem] tracking-[0.25em] text-muted uppercase">Facetas</p>
        <ul class="flex flex-col gap-2">
          {
            FACETS.map(({ id, label, href }) => (
              <li data-facet={id}>
                <a
                  href={href}
                  class="group inline-flex items-center gap-2.5 py-1 text-ink transition-all duration-500 ease-apple hover:translate-x-1 hover:text-primary"
                >
                  <span aria-hidden="true" class="size-1.5 rounded-full bg-primary transition-transform duration-500 ease-apple group-hover:scale-150" />
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="flex flex-col gap-4 md:col-span-3">
      <p class="text-[0.65rem] tracking-[0.25em] text-muted uppercase">Sígueme</p>
      <ul class="flex flex-wrap gap-3">
        {
          SOCIAL_LINKS.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${social.label} de ${SITE.name}`}
                class="grid size-11 place-items-center rounded-full border border-line text-primary transition-all duration-500 ease-apple hover:-translate-y-1 hover:border-primary hover:bg-primary hover:text-on-primary active:scale-95"
              >
                <SocialIcon id={social.id} className="size-4" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="relative border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center gap-2 px-4 py-6 text-center text-xs text-muted md:flex-row md:justify-between md:px-8 md:text-left"
    >
      <p>© {year} {SITE.name}. Todos los derechos reservados.</p>
      <p>
        Made by{" "}
        <a
          href={AGENCY.href}
          target="_blank"
          rel="noopener"
          class="font-medium text-primary underline decoration-primary/30 underline-offset-4 transition-colors duration-300 hover:decoration-primary"
        >
          {AGENCY.name}
        </a>
      </p>
    </div>
  </div>
</footer>
