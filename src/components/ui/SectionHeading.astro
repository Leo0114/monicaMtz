---
import ScrollReveal from "@/components/shared/ScrollReveal";

interface Props {
  eyebrow: string;
  /** Parte del título en itálica y color primary (opcional). */
  accent?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  as?: "h1" | "h2";
}

const { eyebrow, title, accent, description, align = "left", as: Tag = "h2" } = Astro.props;
const centered = align === "center";
---

<ScrollReveal client:visible className={centered ? "mx-auto max-w-2xl text-center" : "max-w-2xl"}>
  <p
    class:list={[
      "mb-5 flex items-center gap-3 text-[0.65rem] font-medium tracking-[0.3em] text-primary uppercase md:text-xs",
      centered && "justify-center",
    ]}
  >
    <span class="h-px w-8 bg-primary" aria-hidden="true"></span>
    {eyebrow}
    {centered && <span class="h-px w-8 bg-primary" aria-hidden="true" />}
  </p>
  <Tag class="font-serif text-4xl leading-[1.02] font-light text-ink md:text-6xl">
    {title}
    {accent && <em class="text-primary">{accent}</em>}
  </Tag>
  {description && <p class="mt-6 text-base leading-relaxed text-muted md:text-lg">{description}</p>}
</ScrollReveal>
