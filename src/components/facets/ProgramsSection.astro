---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import placeholder from "@/assets/realLogo.jpeg";
import ScrollReveal from "@/components/shared/ScrollReveal";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { SOCIAL_LINKS } from "@/constants/site";
import type { Programa } from "@/api/home";

interface Props {
  programs: Programa[];
}

const { programs } = Astro.props;

/** Logos de cada programa. Sustituir el placeholder cuando lleguen los archivos finales. */
const LOGOS: Record<Programa["id"], ImageMetadata> = {
  "se-dijo-y-punto": placeholder,
  "eso-no-se-dice": placeholder,
  "tu-turno": placeholder,
};

const youtube = SOCIAL_LINKS.find((s) => s.id === "youtube")!;
---

<section id="programas" class="relative bg-surface px-4 py-24 md:px-8 md:py-36">
  <div class="mx-auto flex max-w-6xl flex-col gap-14 md:gap-20">
    <SectionHeading
      eyebrow="Programas"
      title="Tres formatos, "
      accent="tres identidades"
      description={`Cada programa tiene su propio logo, tono y comunidad. Episodios completos en YouTube ${youtube.handle}.`}
    />

    <ul class="grid gap-5 md:grid-cols-3 md:gap-6">
      {
        programs.map((program, i) => (
          <li>
            <ScrollReveal client:visible delay={i * 0.12} className="h-full">
              <a
                href={youtube.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-line bg-bgColor transition-[translate,box-shadow,border-color,scale] duration-700 ease-apple hover:-translate-y-1.5 hover:border-primary/40 hover:shadow-[0_30px_60px_-30px] hover:shadow-primary/40 active:scale-[0.985] active:duration-150"
              >
                <div class="relative aspect-square overflow-hidden bg-primary/10">
                  <Image
                    src={LOGOS[program.id]}
                    alt={`Logo de ${program.nombre}`}
                    widths={[360, 540, 720]}
                    sizes="(min-width: 768px) 30vw, 90vw"
                    class="size-full object-cover transition-transform duration-[1.6s] ease-apple group-hover:scale-105"
                  />
                  <span class="absolute top-4 left-4 rounded-full bg-glass px-3.5 py-1.5 text-[0.6rem] font-medium tracking-[0.25em] text-primary uppercase backdrop-blur-xl">
                    {program.formato}
                  </span>
                </div>
                <div class="flex flex-1 flex-col gap-3 p-7 md:p-8">
                  <h3 class="font-serif text-3xl leading-tight text-ink">{program.nombre}</h3>
                  <p class="text-sm leading-relaxed text-muted md:text-base">{program.descripcion}</p>
                  <span class="mt-auto flex items-center gap-2 pt-4 text-[0.65rem] font-medium tracking-[0.25em] text-primary uppercase">
                    Ver en YouTube
                    <svg
                      viewBox="0 0 24 24"
                      class="size-4 transition-transform duration-500 ease-apple group-hover:translate-x-1"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0-5-5m5 5-5 5" />
                    </svg>
                  </span>
                </div>
              </a>
            </ScrollReveal>
          </li>
        ))
      }
    </ul>
  </div>
</section>
