---
import ScrollReveal from "@/components/shared/ScrollReveal";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { FACETS, type FacetId } from "@/constants/site";

/**
 * Puerta de entrada a las facetas. Cada tarjeta lleva `data-facet`, así se
 * pinta con la paleta de su faceta aunque la página tenga otra.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  accent?: string;
  description?: string;
  /** Oculta la faceta actual cuando se usa al final de su propia página. */
  exclude?: FacetId;
  id?: string;
}

const {
  eyebrow = "Facetas",
  title = "Cuatro caminos, ",
  accent = "una misma voz",
  description = "Pinto, escribo, produzco y creo contenido. Cada faceta tiene su propio espacio, su color y su ritmo.",
  exclude,
  id = "facetas",
} = Astro.props;

const facets = FACETS.map((facet, i) => ({ ...facet, number: i + 1 })).filter((f) => f.id !== exclude);
---

<section id={id} class="relative px-4 py-24 md:px-8 md:py-36">
  <div class="mx-auto flex max-w-6xl flex-col gap-14 md:gap-20">
    <SectionHeading eyebrow={eyebrow} title={title} accent={accent} description={description} />

    <ul
      class:list={[
        "grid gap-4 sm:grid-cols-2 md:gap-5",
        facets.length === 4 ? "lg:grid-cols-4" : "md:grid-cols-3",
      ]}
    >
      {
        facets.map((facet, i) => (
          <li data-facet={facet.id}>
            <ScrollReveal client:visible delay={i * 0.1} className="h-full">
              <a
                href={facet.href}
                class="group relative isolate flex h-full min-h-[19rem] flex-col justify-between gap-12 overflow-hidden rounded-[1.75rem] bg-primary p-7 text-on-primary shadow-[0_30px_60px_-36px] shadow-primary/70 transition-[translate,box-shadow,scale] duration-700 ease-apple hover:-translate-y-1.5 hover:shadow-[0_40px_70px_-30px] active:scale-[0.985] active:duration-150 md:min-h-[24rem] md:p-8"
              >
                <!-- Inicial gigante como textura -->
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute -right-6 -bottom-16 -z-10 font-serif text-[16rem] leading-none text-on-primary/10 italic transition-transform duration-1000 ease-apple select-none group-hover:-translate-x-3 group-hover:-translate-y-3"
                >
                  {facet.label[0]}
                </span>
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute -top-20 -left-20 -z-10 size-48 rounded-full bg-primary-soft opacity-60 blur-3xl transition-opacity duration-700 group-hover:opacity-100"
                />

                <div class="flex items-start justify-between">
                  <span class="font-sans text-xs tracking-widest opacity-75">0{facet.number}</span>
                  <span class="grid size-11 place-items-center rounded-full bg-on-primary/15 backdrop-blur-sm transition-[rotate,scale,background-color] duration-700 ease-apple group-hover:scale-110 group-hover:-rotate-45 group-hover:bg-on-primary group-hover:text-primary">
                    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0-5-5m5 5-5 5" />
                    </svg>
                  </span>
                </div>

                <div>
                  <h3 class="font-serif text-4xl leading-[0.95] font-light md:text-[2.75rem]">{facet.label}</h3>
                  <p class="mt-3 max-w-[16rem] text-sm leading-relaxed opacity-85">{facet.tagline}</p>
                </div>
              </a>
            </ScrollReveal>
          </li>
        ))
      }
    </ul>
  </div>
</section>
