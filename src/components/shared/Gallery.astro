---
import { Image } from "astro:assets";
import { FiMaximize2 } from "react-icons/fi";

interface Props {
  /** Carpeta dentro de `src/assets/` — p. ej. `images/gal/temp`. */
  name: string;
  /** Accessible label for the group; also rendered when `showTitle`. */
  title?: string;
  eyebrow?: string;
  /** `mosaic` gives the first image a hero cell; `grid` keeps every cell equal; `masonry` keeps natural aspect ratio in columns without cropping. */
  layout?: "mosaic" | "grid" | "masonry";
  /** Custom row height for desktop / tablet — accepts any CSS value (e.g. "18rem"). */
  rowHeight?: string;
  /** Custom row height for mobile screens (< sm). Defaults to 11.5rem if rowHeight is set. */
  mobileRowHeight?: string;
  /** Whether thumbnails in mobile should display the entire photo without cropping. */
  containMobile?: boolean;
  /** 0-based indices of images that should focus on the top (e.g. faces). */
  focusTop?: number[];
  class?: string;
}

const {
  name,
  title,
  eyebrow,
  layout = "mosaic",
  rowHeight,
  mobileRowHeight,
  containMobile = false,
  focusTop = [],
  class: className = "",
} = Astro.props;

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}",
  { eager: true },
);

/** Convierte `atardecer-en-la-sierra.jpg` en `Atardecer en la sierra`. */
const toLabel = (path: string) =>
  path
    .split("/")
    .pop()!
    .replace(/-[\w-]{11}-unsplash(?=\.)/i, "") // créditos de Unsplash en imágenes temporales
    .replace(/\.(jpe?g|png|webp|avif)/gi, "")
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/^./, (c) => c.toUpperCase());

const images = Object.entries(modules)
  .filter(([path]) => path.includes(`/assets/${name}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({ src: mod.default, label: toLabel(path) }));

const galleryId = `pswp-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
const isMasonry = layout === "masonry";
const hasCustomRows = Boolean(rowHeight || mobileRowHeight);

/**
 * Mosaic rhythm: the opening frame is wide, then the grid alternates so no two
 * adjacent rows share the same shape. Anything past the pattern repeats it.
 */
const mosaicSpans = [
  "sm:col-span-4 sm:row-span-2",
  "sm:col-span-2",
  "sm:col-span-2",
  "sm:col-span-3",
  "sm:col-span-3",
  "sm:col-span-2",
  "sm:col-span-4",
  "sm:col-span-2",
];
---

{
  images.length > 0 && (
    <figure class:list={["not-prose", className]}>
      {(eyebrow || title) && (
        <figcaption class="mb-10 md:mb-14">
          {eyebrow && <p class="flex items-center gap-3 text-[0.65rem] font-medium tracking-[0.3em] text-primary uppercase md:text-xs">
              <span class="h-px w-8 bg-primary" aria-hidden="true" />
              {eyebrow}
            </p>}
          {title && <h2 class="mt-5 font-serif text-4xl leading-[1.02] font-light text-ink md:text-6xl">{title}</h2>}
        </figcaption>
      )}

      <div
        id={galleryId}
        data-pswp-gallery
        class:list={[
          isMasonry
            ? "columns-1 min-[480px]:columns-2 lg:columns-3 gap-4 md:gap-6 [column-fill:_balance]"
            : "grid grid-cols-2 gap-3 sm:gap-4",
          !isMasonry && !hasCustomRows && "auto-rows-[13rem] sm:auto-rows-[11rem] lg:auto-rows-[13rem]",
          !isMasonry && hasCustomRows && "gallery-custom-rows",
          !isMasonry && (layout === "mosaic" ? "sm:grid-cols-6" : "sm:grid-cols-3"),
        ]}
        style={!isMasonry && hasCustomRows
          ? {
              "--mobile-row-h": mobileRowHeight || "11.5rem",
              "--desktop-row-h": rowHeight || "13rem",
            }
          : undefined}
      >
        {images.map(({ src, label }, i) => {
          const isTopFocused = focusTop.includes(i);
          return (
            <a
              href={src.src}
              data-pswp-width={src.width}
              data-pswp-height={src.height}
              data-pswp-caption={label}
              target="_blank"
              rel="noreferrer"
              aria-label={label}
              class:list={[
                "group relative block overflow-hidden rounded-[1.25rem] bg-surface shadow-[0_24px_50px_-32px] shadow-primary/50 transition-[scale] duration-500 ease-apple focus-visible:outline-offset-4 active:scale-[0.985] active:duration-150",
                isMasonry && "break-inside-avoid mb-4 border border-line/60 md:mb-6",
                !isMasonry && (layout === "mosaic"
                  ? mosaicSpans[i % mosaicSpans.length]
                  : "sm:col-span-1"),
                !isMasonry && layout === "mosaic" && i === 0 && "col-span-2 row-span-2",
                !isMasonry && containMobile && "max-sm:p-1.5 max-sm:bg-surface/90",
              ]}
            >
              <Image
                src={src}
                alt={label}
                widths={[400, 800, 1200]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 92vw"
                loading={i < 4 ? "eager" : "lazy"}
                class:list={[
                  "transition-transform duration-[1.2s] ease-apple group-hover:scale-[1.03]",
                  isMasonry
                    ? "w-full h-auto block"
                    : "size-full",
                  !isMasonry && (containMobile
                    ? "max-sm:object-contain max-sm:rounded-xl sm:object-cover"
                    : "object-cover"),
                  !isMasonry && isTopFocused && "object-top",
                ]}
              />

              {/* Scrim + affordance only appear on intent, so the photo stays clean */}
              <span
                class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/55 via-black/0 to-black/0 opacity-0 transition-opacity duration-400 group-hover:opacity-100 group-focus-visible:opacity-100"
                aria-hidden="true"
              />
              <span
                class="pointer-events-none absolute bottom-3 left-4 right-4 flex items-center justify-between gap-3 translate-y-2 opacity-0 transition-[opacity,transform] duration-400 ease-apple group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100"
                aria-hidden="true"
              >
                <span class="truncate text-[0.65rem] font-medium tracking-[0.2em] text-white/90 uppercase">{label}</span>
                <FiMaximize2 className="h-4 w-4 shrink-0 text-white/80" />
              </span>
            </a>
          );
        })}
      </div>
    </figure>
  )
}

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  let lightboxes: PhotoSwipeLightbox[] = [];

  function initGalleries() {
    destroyGalleries();

    document
      .querySelectorAll<HTMLElement>("[data-pswp-gallery]")
      .forEach((el) => {
        const lb = new PhotoSwipeLightbox({
          gallery: `#${el.id}`,
          children: "a",
          bgOpacity: 0.92,
          pswpModule: () => import("photoswipe"),
        });

        lb.on("uiRegister", () => {
          lb.pswp?.ui?.registerElement({
            name: "caption",
            order: 9,
            isButton: false,
            appendTo: "root",
            html: "",
            onInit: (el, pswp) => {
              el.classList.add("pswp-caption");
              pswp.on("change", () => {
                el.textContent =
                  pswp.currSlide?.data.element?.dataset.pswpCaption ?? "";
              });
            },
          });
        });

        // Lenis no debe mover la página mientras el visor está abierto.
        lb.on("beforeOpen", () => window.mmLenis?.stop());
        lb.on("destroy", () => window.mmLenis?.start());

        lb.init();
        lightboxes.push(lb);
      });
  }

  function destroyGalleries() {
    lightboxes.forEach((lb) => lb.destroy());
    lightboxes = [];
  }

  document.addEventListener("astro:page-load", initGalleries);
  document.addEventListener("astro:before-swap", destroyGalleries);
</script>

<style>
  .gallery-custom-rows {
    grid-auto-rows: var(--mobile-row-h, 11.5rem);
  }
  @media (min-width: 640px) {
    .gallery-custom-rows {
      grid-auto-rows: var(--desktop-row-h, 13rem);
    }
  }
</style>

<style is:global>
  .pswp-caption {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    translate: -50% 0;
    max-width: min(40rem, 90vw);
    text-align: center;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.82);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.6);
  }
</style>
