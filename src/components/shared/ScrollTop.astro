<button
  id="scroll-to-top"
  type="button"
  aria-label="Volver arriba"
  data-visible="false"
  class="group fixed right-4 bottom-4 z-40 grid size-11 cursor-pointer place-items-center rounded-full border border-line bg-glass text-primary shadow-lg shadow-primary/10 backdrop-blur-xl transition-all duration-500 ease-apple hover:-translate-y-1 hover:bg-primary hover:text-on-primary active:scale-95 data-[visible=false]:pointer-events-none data-[visible=false]:translate-y-6 data-[visible=false]:opacity-0 md:right-8 md:bottom-8 md:size-12"
>
  <svg
    aria-hidden="true"
    class="size-4 transition-transform duration-500 ease-apple group-hover:-translate-y-0.5"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="1.6"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m0 0-6 6m6-6 6 6"></path>
  </svg>
</button>

<script>
  import { scrollToTop } from "@/scripts/smooth-scroll";

  const update = () => {
    const btn = document.getElementById("scroll-to-top");
    btn?.setAttribute("data-visible", String(window.scrollY > 480));
  };

  window.addEventListener("scroll", update, { passive: true });
  document.addEventListener("astro:page-load", update);
  document.addEventListener("click", (event) => {
    if ((event.target as Element | null)?.closest("#scroll-to-top")) scrollToTop();
  });
</script>
