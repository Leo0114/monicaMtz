---
import { Image } from "astro:assets";
import brandLogo from "@/assets/realLogo.jpeg";
import ScrollReveal from "@/components/shared/ScrollReveal";
import SocialIcon from "@/components/shared/SocialIcon";
import { CONTACT, SOCIAL_LINKS } from "@/constants/site";

const CHANNELS = [
  {
    label: "Correo",
    value: "Envíame un correo",
    href: `mailto:${CONTACT.email}`,
    icon: "M3 7l9 6 9-6M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z",
  },
  {
    label: "Teléfono",
    value: "Llamar",
    href: CONTACT.phoneHref,
    icon: "M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z",
  },
];
---

<div class="flex flex-col gap-10">
  <ul class="flex flex-col gap-4">
    {
      CHANNELS.map((channel, i) => (
        <li>
          <ScrollReveal client:visible delay={0.15 + i * 0.1}>
            <a
              href={channel.href}
              class="group flex items-center gap-5 rounded-3xl border border-line p-5 transition-all duration-700 ease-apple hover:-translate-y-1 hover:border-primary/40 hover:bg-surface hover:shadow-[0_24px_50px_-30px] hover:shadow-primary/40 active:scale-[0.98]"
            >
              <span class="grid size-12 shrink-0 place-items-center rounded-full bg-primary text-on-primary transition-transform duration-700 ease-apple group-hover:scale-110 group-hover:-rotate-6">
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={channel.icon} />
                </svg>
              </span>
              <span class="flex flex-col">
                <span class="text-[0.65rem] tracking-[0.25em] text-muted uppercase">{channel.label}</span>
                <span class="font-serif text-2xl text-ink">{channel.value}</span>
              </span>
              <svg viewBox="0 0 24 24" class="ml-auto size-5 text-primary opacity-40 transition-all duration-500 ease-apple group-hover:translate-x-1 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0-5-5m5 5-5 5" />
              </svg>
            </a>
          </ScrollReveal>
        </li>
      ))
    }
  </ul>

  <ScrollReveal client:visible delay={0.35} className="flex flex-col gap-5">
    <p class="text-[0.65rem] tracking-[0.25em] text-muted uppercase">Sígueme en redes</p>
    <ul class="grid grid-cols-2 gap-3">
      {
        SOCIAL_LINKS.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-3 rounded-full border border-line py-2 pr-4 pl-2 text-sm text-ink transition-all duration-500 ease-apple hover:border-primary hover:bg-primary hover:text-on-primary active:scale-95"
            >
              <span class="grid size-9 place-items-center rounded-full bg-primary/10 text-primary transition-colors duration-500 group-hover:bg-on-primary/15 group-hover:text-on-primary">
                <SocialIcon id={social.id} className="size-4" />
              </span>
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </ScrollReveal>

  <ScrollReveal client:visible delay={0.45} className="hidden md:block">
    <figure class="group overflow-hidden rounded-[2rem] border border-line">
      <Image
        src={brandLogo}
        alt="Monograma de Mónica Martínez"
        width={640}
        class="aspect-[16/10] w-full object-cover transition-transform duration-[1.6s] ease-apple group-hover:scale-105"
      />
    </figure>
  </ScrollReveal>
</div>
