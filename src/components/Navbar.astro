---
import { Image } from "astro:assets";
import faceLogo from "@/assets/logo.png";
import ThemeToggle from "@/components/shared/ThemeToggle.astro";
import MobileMenu from "@/components/MobileMenu";
import SocialIcon from "@/components/shared/SocialIcon";
import { ALL_LINKS, FACETS, NAV_LINKS, SITE, SOCIAL_LINKS } from "@/constants/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => currentPath === href;
const inFacet = FACETS.some((f) => isActive(f.href));
const [home, contact] = NAV_LINKS;
const linkClass =
  "group relative py-2 text-[0.7rem] font-medium tracking-[0.22em] text-muted uppercase transition-colors duration-500 hover:text-ink aria-[current=page]:text-ink";
const underlineClass =
  "absolute inset-x-0 -bottom-0.5 h-px origin-left scale-x-0 bg-primary transition-transform duration-500 ease-apple group-hover:scale-x-100 group-aria-[current=page]:scale-x-100";
---

<header
  id="site-header"
  data-scrolled="false"
  class="group/header fixed inset-x-0 top-0 z-50 px-4 pt-3 transition-[padding] duration-700 ease-apple md:px-8 md:pt-5 data-[scrolled=true]:md:pt-3"
>
  <nav
    aria-label="Principal"
    class="mx-auto flex h-14 max-w-6xl items-center justify-between rounded-full md:grid md:grid-cols-[auto_1fr_auto] lg:grid-cols-[1fr_auto_1fr] border border-transparent px-3 transition-all duration-700 ease-apple group-data-[scrolled=true]/header:border-line group-data-[scrolled=true]/header:bg-glass group-data-[scrolled=true]/header:shadow-[0_8px_32px_-16px] group-data-[scrolled=true]/header:shadow-primary/25 group-data-[scrolled=true]/header:backdrop-blur-xl group-data-[scrolled=true]/header:backdrop-saturate-150 md:h-16 md:px-5"
  >
    <a href="/" class="group flex items-center gap-3 md:justify-self-start" aria-label={`${SITE.name}, inicio`}>
      <span
        class="grid size-9 place-items-center overflow-hidden rounded-full border border-line bg-surface transition-transform duration-700 ease-apple group-hover:rotate-[-6deg] md:size-10"
      >
        <Image
          src={faceLogo}
          alt=""
          width={80}
          height={80}
          loading="eager"
          class="size-full object-cover mix-blend-multiply dark:mix-blend-normal dark:invert"
        />
      </span>
      <span class="font-serif text-lg leading-none tracking-wide whitespace-nowrap text-ink md:hidden lg:inline lg:text-xl">
        {SITE.name}
      </span>
    </a>

    <!-- Redes al centro: lo más importante, siempre a la vista en escritorio -->
    <ul aria-label="Redes sociales" class="hidden items-center gap-1 md:flex md:justify-self-center lg:gap-2">
      {
        SOCIAL_LINKS.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              title={social.label}
              class="group/social relative grid size-9 place-items-center rounded-full text-muted transition-all duration-500 ease-apple hover:-translate-y-0.5 hover:bg-primary/10 hover:text-primary active:scale-90"
            >
              <SocialIcon id={social.id} className="size-[0.95rem] transition-transform duration-500 ease-apple group-hover/social:scale-110" />
              <span
                aria-hidden="true"
                class="absolute -bottom-0.5 size-1 scale-0 rounded-full bg-primary transition-transform duration-500 ease-apple group-hover/social:scale-100"
              />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden items-center gap-6 md:flex md:justify-self-end lg:gap-8">
      <ul class="flex items-center gap-5 lg:gap-7">
        <li>
          <a href={home.href} aria-current={isActive(home.href) ? "page" : undefined} class={linkClass}>
            {home.label}
            <span class={underlineClass}></span>
          </a>
        </li>

        <!-- Facetas: el panel nace del propio botón (transform-origin arriba) -->
        <li class="relative">
          <button
            type="button"
            data-facets-trigger
            aria-expanded="false"
            aria-controls="facets-menu"
            aria-current={inFacet ? "page" : undefined}
            class:list={[linkClass, "flex cursor-pointer items-center gap-1.5"]}
          >
            Facetas
            <svg
              viewBox="0 0 24 24"
              class="size-3 transition-transform duration-500 ease-apple group-aria-expanded:rotate-180"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"></path>
            </svg>
            <span class={underlineClass}></span>
          </button>

          <div
            id="facets-menu"
            data-open="false"
            class="absolute top-full left-1/2 mt-4 w-96 origin-top -translate-x-1/2 rounded-3xl border border-line bg-surface p-2 shadow-[0_30px_60px_-24px] shadow-black/30 transition-[opacity,scale,translate,visibility] duration-500 ease-apple data-[open=false]:invisible data-[open=false]:-translate-y-1 data-[open=false]:scale-95 data-[open=false]:opacity-0"
          >
            <ul class="flex flex-col">
              {
                FACETS.map((facet) => (
                  <li data-facet={facet.id}>
                    <a
                      href={facet.href}
                      aria-current={isActive(facet.href) ? "page" : undefined}
                      class="group/item flex items-center gap-4 rounded-2xl p-3 transition-colors duration-300 hover:bg-primary/10 active:scale-[0.98] aria-[current=page]:bg-primary/10"
                    >
                      <span class="grid size-10 shrink-0 place-items-center rounded-full bg-primary text-on-primary shadow-md shadow-primary/30 transition-transform duration-500 ease-apple group-hover/item:scale-110 group-hover/item:-rotate-6">
                        <span class="font-serif text-lg leading-none italic">{facet.label[0]}</span>
                      </span>
                      <span class="flex min-w-0 flex-col">
                        <span class="font-serif text-xl leading-tight text-ink">{facet.label}</span>
                        <span class="truncate text-xs text-muted">{facet.tagline}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>

        <li>
          <a href={contact.href} aria-current={isActive(contact.href) ? "page" : undefined} class={linkClass}>
            {contact.label}
            <span class={underlineClass}></span>
          </a>
        </li>
      </ul>
      <span class="h-5 w-px bg-line" aria-hidden="true"></span>
      <ThemeToggle />
    </div>

    <div class="flex items-center gap-3 md:hidden">
      <ThemeToggle />
      <MobileMenu client:media="(max-width: 767px)" links={ALL_LINKS} socials={SOCIAL_LINKS} currentPath={currentPath} />
    </div>
  </nav>
</header>

<script>
  const update = () => {
    document
      .getElementById("site-header")
      ?.setAttribute("data-scrolled", String(window.scrollY > 24));
  };
  window.addEventListener("scroll", update, { passive: true });
  document.addEventListener("astro:page-load", update);

  // Menú de facetas: delegación en document para sobrevivir a los swaps del ClientRouter.
  const setFacetsOpen = (open: boolean) => {
    document.getElementById("facets-menu")?.setAttribute("data-open", String(open));
    document.querySelector("[data-facets-trigger]")?.setAttribute("aria-expanded", String(open));
  };
  const isFacetsOpen = () => document.getElementById("facets-menu")?.dataset.open === "true";

  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    if (target?.closest("[data-facets-trigger]")) setFacetsOpen(!isFacetsOpen());
    else if (!target?.closest("#facets-menu") || target.closest("a")) setFacetsOpen(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !isFacetsOpen()) return;
    setFacetsOpen(false);
    document.querySelector<HTMLElement>("[data-facets-trigger]")?.focus();
  });
</script>
