---
import { Image } from "astro:assets";
import brandLogo from "@/assets/realLogo.jpeg";

// Slider continuo: mismas imágenes en formatos distintos para dar ritmo editorial.
const FRAMES = [
  "aspect-[3/4] w-52 md:w-72 rounded-t-full rounded-b-3xl",
  "aspect-square w-60 md:w-80 rounded-3xl",
  "aspect-[4/5] w-52 md:w-64 rounded-3xl",
  "aspect-[3/4] w-56 md:w-72 rounded-full",
  "aspect-square w-52 md:w-72 rounded-t-3xl rounded-b-full",
];
const loop = [...FRAMES, ...FRAMES, ...FRAMES, ...FRAMES];
---

<section aria-label="Galería" class="relative overflow-hidden py-20 md:py-28">
  <div class="group flex w-max animate-marquee items-center [animation-duration:80s] hover:[animation-play-state:paused]">
    {
      loop.map((frame, i) => (
        <div
          aria-hidden={i >= FRAMES.length ? "true" : undefined}
          class:list={[
            "mr-5 shrink-0 overflow-hidden border md:mr-8 border-line bg-surface shadow-[0_30px_60px_-40px] shadow-primary/40 transition-all duration-1000 ease-apple hover:scale-[1.03]",
            frame,
            i % 2 === 1 && "translate-y-8",
          ]}
        >
          <Image
            src={brandLogo}
            alt={i < FRAMES.length ? "Mónica Martínez" : ""}
            width={640}
            loading="lazy"
            class="size-full object-cover transition-transform duration-[1.6s] ease-apple hover:scale-110"
          />
        </div>
      ))
    }
  </div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 w-12 bg-linear-to-r from-bgColor to-transparent md:w-40"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 w-12 bg-linear-to-l from-bgColor to-transparent md:w-40"></div>
</section>
