---
import { Image } from "astro:assets";
import brandLogo from "@/assets/realLogo.jpeg";
import ScrollReveal from "@/components/shared/ScrollReveal";

const PILLARS = [
  {
    title: "Escribir",
    text: "Cuentos que nombran lo que muchas mujeres viven en silencio: pérdidas, vínculos y verdades incómodas.",
  },
  {
    title: "Conversar",
    text: "Diálogos íntimos, sin filtros, sobre lo que normalmente se calla pero todas necesitamos escuchar.",
  },
  {
    title: "Inspirar",
    text: "Bienestar, movimiento y comunidad para demostrar que nunca es tarde para empezar de nuevo.",
  },
];
---

<section id="sobre-mi" class="relative px-4 py-24 md:px-8 md:py-36">
  <div class="mx-auto grid max-w-6xl gap-14 md:grid-cols-12 md:gap-12">
    <ScrollReveal client:visible direction="right" className="md:col-span-5">
      <figure class="group relative">
        <div class="overflow-hidden rounded-[2rem] border border-line bg-surface">
          <Image
            src={brandLogo}
            alt="Monograma de Mónica Martínez"
            widths={[480, 720]}
            sizes="(min-width: 768px) 40vw, 100vw"
            class="aspect-square w-full object-cover transition-transform duration-[1.6s] ease-apple group-hover:scale-105"
          />
        </div>
        <figcaption
          class="absolute -right-2 -bottom-5 rounded-full border border-line bg-glass px-5 py-3 text-[0.65rem] tracking-[0.25em] text-primary uppercase shadow-lg shadow-primary/10 backdrop-blur-xl md:-right-6"
        >
          Hecho en Monterrey
        </figcaption>
      </figure>
    </ScrollReveal>

    <div class="flex flex-col justify-center gap-10 md:col-span-7 md:pl-8">
      <ScrollReveal client:visible>
        <p class="mb-5 flex items-center gap-3 text-[0.65rem] font-medium tracking-[0.3em] text-primary uppercase md:text-xs">
          <span class="h-px w-8 bg-primary" aria-hidden="true"></span>
          Sobre mí
        </p>
        <h2 class="font-serif text-4xl leading-[1.05] font-light text-ink md:text-6xl">
          Madre, escritora y <em class="text-primary">mujer que se atreve</em>.
        </h2>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-muted md:text-lg">
          Soy Mónica, regiomontana de corazón. Después de toda una vida dedicada a mi familia, decidí contar las
          historias que llevaba dentro. Hoy escribo, comparto y acompaño a una comunidad que cree —como yo— que
          primero hay que ser, y después tener.
        </p>
      </ScrollReveal>

      <ol class="grid gap-px overflow-hidden rounded-3xl border border-line bg-line sm:grid-cols-3">
        {
          PILLARS.map((pillar, i) => (
            <li class="bg-bgColor">
              <ScrollReveal client:visible delay={i * 0.12} className="group h-full p-6 transition-colors duration-700 hover:bg-surface">
                <span class="font-sans text-xs tracking-widest text-primary">0{i + 1}</span>
                <h3 class="mt-3 font-serif text-2xl text-ink transition-transform duration-700 ease-apple group-hover:translate-x-1">
                  {pillar.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{pillar.text}</p>
              </ScrollReveal>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
